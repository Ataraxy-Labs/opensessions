(
    id: r#"droid"#,
    rules: [
(
            id: r#"execute_selection_blocker"#,
            state: Some(Blocked),
            priority: 300,
            region: r#"whole_recent"#,
            visible_blocker: true,
            gate: (
                contains: [r#"enter to select"#, r#"esc to cancel"#],
                all: [
                    (
                        any: [
                            (
                                contains: [r#"> yes, allow"#],
                            ),
                            (
                                contains: [r#"> no, cancel"#],
                            ),
                        ],
                    ),
                ],
                any: [
                    (
                        contains: [r#"↑↓ to navigate"#],
                    ),
                    (
                        contains: [r#"use ↑↓ to navigate"#],
                    ),
                ],
            ),
        ),
(
            id: r#"selection_menu_blocker"#,
            state: Some(Blocked),
            priority: 290,
            region: r#"bottom_non_empty_lines(8)"#,
            visible_blocker: true,
            gate: (
                contains: [r#"enter select"#, r#"esc cancel"#],
                any: [
                    (
                        contains: [r#"↑/↓ navigate"#],
                    ),
                    (
                        contains: [r#"↑↓ navigate"#],
                    ),
                ],
            ),
        ),
(
            id: r#"spinner_stop_working"#,
            state: Some(Working),
            priority: 110,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                contains: [r#"esc to stop"#],
                line_regex: [r#"^\s*[\u2800-\u28FF]"#],
            ),
        ),
(
            id: r#"stop_hint_working"#,
            state: Some(Working),
            priority: 100,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                contains: [r#"esc to stop"#],
            ),
        ),
    ],
)
