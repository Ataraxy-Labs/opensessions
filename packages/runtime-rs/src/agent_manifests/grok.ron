(
    id: r#"grok"#,
    aliases: [r#"grok-build"#],
    rules: [
(
            id: r#"permission_scope_selector"#,
            state: Some(Blocked),
            priority: 300,
            region: r#"whole_recent"#,
            visible_blocker: true,
            gate: (
                contains: [r#"yes, proceed"#, r#"no, reject"#],
                any: [
                    (
                        contains: [r#"use ← → to choose permission whitelist scope"#],
                    ),
                    (
                        contains: [r#"←/→:scope"#],
                    ),
                ],
            ),
        ),
(
            id: r#"waiting_tool_working"#,
            state: Some(Working),
            priority: 120,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                any: [
                    (
                        all: [
                            (
                                contains: [r#"ctrl+c:cancel"#, r#"ctrl+enter:interject"#],
                            ),
                            (
                                contains: [r#"waiting"#],
                            ),
                        ],
                    ),
                    (
                        line_regex: [r#"^\s*[\u2800-\u28FF]\s+(Run|Read|Search|List)\b"#],
                    ),
                ],
            ),
        ),
    ],
)
