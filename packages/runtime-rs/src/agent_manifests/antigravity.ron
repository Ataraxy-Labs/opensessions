(
    id: r#"agy"#,
    aliases: [r#"antigravity"#, r#"antigravity-cli"#],
    rules: [
(
            id: r#"permission_prompt"#,
            state: Some(Blocked),
            priority: 300,
            region: r#"whole_recent"#,
            visible_blocker: true,
            gate: (
                contains: [r#"requesting permission for:"#],
                any: [
                    (
                        contains: [r#"do you want to proceed?"#],
                    ),
                    (
                        contains: [r#"tab amend"#, r#"edit command"#],
                    ),
                ],
            ),
        ),
(
            id: r#"spinner_working"#,
            state: Some(Working),
            priority: 100,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                line_regex: [r#"^\s*[\u2800-\u28FF]+\s+\p{Alphabetic}+\w*ing\b"#],
            ),
        ),
(
            id: r#"background_tasks_working"#,
            state: Some(Working),
            priority: 90,
            region: r#"bottom_non_empty_lines(5)"#,
            visible_working: true,
            gate: (
                line_regex: [r#"(?i).*[1-9][0-9]*\s*·?\s+tasks?.*/tasks"#],
            ),
        ),
    ],
)
