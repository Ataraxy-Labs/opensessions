(
    id: r#"hermes"#,
    aliases: [r#"hermes-agent"#],
    rules: [
(
            id: r#"dangerous_command_approval"#,
            state: Some(Blocked),
            priority: 300,
            region: r#"whole_recent"#,
            visible_blocker: true,
            gate: (
                all: [
                    (
                        any: [
                            (
                                contains: [r#"enter to confirm"#],
                            ),
                            (
                                contains: [r#"↑/↓ to select"#],
                            ),
                            (
                                contains: [r#"show full command"#],
                            ),
                        ],
                    ),
                ],
                any: [
                    (
                        contains: [r#"dangerous command"#],
                    ),
                    (
                        contains: [r#"allow once"#, r#"allow for this session"#, r#"deny"#],
                    ),
                ],
            ),
        ),
(
            id: r#"interrupt_status_working"#,
            state: Some(Working),
            priority: 100,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                any: [
                    (
                        contains: [r#"msg=interrupt"#],
                    ),
                    (
                        contains: [r#"ctrl+c cancel"#],
                    ),
                ],
            ),
        ),
    ],
)
