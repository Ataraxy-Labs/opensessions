(
    id: r#"gemini"#,
    rules: [
(
            id: r#"apply_or_allow_change"#,
            state: Some(Blocked),
            priority: 300,
            region: r#"whole_recent"#,
            visible_blocker: true,
            gate: (
                any: [
                    (
                        contains: [r#"│ Apply this change"#],
                    ),
                    (
                        contains: [r#"│ Allow execution"#],
                    ),
                    (
                        all: [
                            (
                                contains: [r#"yes"#],
                            ),
                            (
                                any: [
                                    (
                                        contains: [r#"waiting for user confirmation"#],
                                    ),
                                    (
                                        contains: [r#"│ Do you want to proceed"#],
                                    ),
                                    (
                                        contains: [r#"do you want to proceed?"#],
                                    ),
                                ],
                            ),
                        ],
                    ),
                    (
                        line_regex: [r#"(?i)^\s*❯.*(yes|allow)"#],
                    ),
                ],
            ),
        ),
(
            id: r#"esc_cancel_working"#,
            state: Some(Working),
            priority: 100,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                contains: [r#"esc to cancel"#],
            ),
        ),
    ],
)
