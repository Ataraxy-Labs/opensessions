(
    id: r#"kiro"#,
    aliases: [r#"kiro-cli"#],
    rules: [
(
            id: r#"tool_approval"#,
            state: Some(Blocked),
            priority: 300,
            region: r#"whole_recent"#,
            visible_blocker: true,
            gate: (
                contains: [r#"requires approval"#],
                any: [
                    (
                        contains: [r#"yes, single permission"#],
                    ),
                    (
                        contains: [r#"trust, always allow"#],
                    ),
                    (
                        contains: [r#"no (tab to edit)"#],
                    ),
                    (
                        contains: [r#"esc to close"#],
                    ),
                ],
            ),
        ),
(
            id: r#"subagent_approval"#,
            state: Some(Blocked),
            priority: 290,
            region: r#"whole_recent"#,
            visible_blocker: true,
            gate: (
                contains: [r#"pending from subagents"#],
                all: [
                    (
                        any: [
                            (
                                contains: [r#"approve all pending"#],
                            ),
                            (
                                contains: [r#"configure individually"#],
                            ),
                            (
                                contains: [r#"exit (cancel subagents)"#],
                            ),
                        ],
                    ),
                ],
                any: [
                    (
                        contains: [r#"tool approval"#],
                    ),
                    (
                        contains: [r#"tool approvals"#],
                    ),
                ],
            ),
        ),
(
            id: r#"kiro_working_marker"#,
            state: Some(Working),
            priority: 100,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                contains: [r#"kiro is working"#],
            ),
        ),
(
            id: r#"tool_spinner_working"#,
            state: Some(Working),
            priority: 90,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                contains: [r#"esc to cancel"#],
                line_regex: [r#"^\s*(◔|◑|◕|●)\s+\p{Alphabetic}"#],
            ),
        ),
    ],
)
