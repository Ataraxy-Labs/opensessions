(
    id: r#"amp"#,
    aliases: [r#"amp-local"#],
    rules: [
(
            id: r#"approval_footer"#,
            state: Some(Blocked),
            priority: 300,
            region: r#"whole_recent"#,
            visible_blocker: true,
            gate: (
                any: [
                    (
                        contains: [r#"waiting for approval"#],
                    ),
                    (
                        contains: [r#"invoke tool"#],
                    ),
                    (
                        contains: [r#"run this command?"#],
                    ),
                    (
                        contains: [r#"allow editing file:"#],
                    ),
                    (
                        contains: [r#"allow creating file:"#],
                    ),
                    (
                        contains: [r#"confirm tool call"#],
                    ),
                    (
                        contains: [r#"approve"#],
                        any: [
                            (
                                contains: [r#"allow all for this session"#],
                            ),
                            (
                                contains: [r#"allow all for every session"#],
                            ),
                            (
                                contains: [r#"allow file for every session"#],
                            ),
                            (
                                contains: [r#"deny with feedback"#],
                            ),
                        ],
                    ),
                ],
            ),
        ),
(
            id: r#"esc_cancel_working"#,
            state: Some(Working),
            priority: 100,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                contains: [r#"esc to cancel"#],
            ),
        ),
    ],
)
