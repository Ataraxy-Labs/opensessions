(
    id: r#"kilo"#,
    aliases: [r#"kilo-code"#, r#"kilo code"#, r#"herdr:kilo"#],
    rules: [
(
            id: r#"opencode_permission"#,
            state: Some(Blocked),
            priority: 300,
            region: r#"whole_recent"#,
            visible_blocker: true,
            gate: (
                any: [
                    (
                        contains: [r#"△ Permission required"#],
                    ),
                    (
                        contains: [r#"esc dismiss"#],
                        all: [
                            (
                                any: [
                                    (
                                        contains: [r#"↑↓ select"#],
                                    ),
                                    (
                                        contains: [r#"⇆ tab"#],
                                    ),
                                ],
                            ),
                        ],
                        any: [
                            (
                                contains: [r#"enter confirm"#],
                            ),
                            (
                                contains: [r#"enter submit"#],
                            ),
                            (
                                contains: [r#"enter toggle"#],
                            ),
                        ],
                    ),
                ],
            ),
        ),
(
            id: r#"esc_interrupt_working"#,
            state: Some(Working),
            priority: 100,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                contains: [r#"esc interrupt"#],
            ),
        ),
    ],
)
