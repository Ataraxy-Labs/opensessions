(
    id: r#"copilot"#,
    aliases: [r#"github-copilot"#, r#"ghcs"#],
    rules: [
(
            id: r#"selection_blocker"#,
            state: Some(Blocked),
            priority: 300,
            region: r#"whole_recent"#,
            visible_blocker: true,
            gate: (
                contains: [r#"esc to cancel"#],
                any: [
                    (
                        contains: [r#"enter to select"#],
                    ),
                    (
                        contains: [r#"enter to confirm"#],
                    ),
                    (
                        contains: [r#"enter to submit"#],
                    ),
                ],
            ),
        ),
(
            id: r#"working_cancel_hint"#,
            state: Some(Working),
            priority: 100,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                any: [
                    (
                        contains: [r#"esc to cancel"#],
                    ),
                    (
                        contains: [r#"esc cancel"#],
                    ),
                    (
                        contains: [r#"esc again to cancel"#],
                    ),
                ],
            ),
        ),
    ],
)
