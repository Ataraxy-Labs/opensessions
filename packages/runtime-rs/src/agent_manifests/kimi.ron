(
    id: r#"kimi"#,
    aliases: [r#"kimi-code"#, r#"kimi code"#],
    rules: [
(
            id: r#"current_approval_panel"#,
            state: Some(Blocked),
            priority: 400,
            region: r#"whole_recent"#,
            visible_blocker: true,
            gate: (
                contains: [r#"↵ confirm"#],
                all: [
                    (
                        contains: [r#" choose"#],
                    ),
                    (
                        any: [
                            (
                                contains: [r#"approve"#],
                            ),
                            (
                                contains: [r#"reject"#],
                            ),
                            (
                                contains: [r#"revise"#],
                            ),
                        ],
                    ),
                ],
                any: [
                    (
                        contains: [r#"run this command?"#],
                    ),
                    (
                        contains: [r#"write this file?"#],
                    ),
                    (
                        contains: [r#"apply these edits?"#],
                    ),
                    (
                        contains: [r#"stop this task?"#],
                    ),
                    (
                        contains: [r#"ready to build with this plan?"#],
                    ),
                    (
                        line_regex: [r#"(?i)^\s*▶?\s*approve .*\?$"#],
                    ),
                ],
            ),
        ),
(
            id: r#"question_panel"#,
            state: Some(Blocked),
            priority: 390,
            region: r#"whole_recent"#,
            visible_blocker: true,
            gate: (
                contains: [r#"↑↓ select"#, r#"esc cancel"#],
                line_regex: [r#"^\s*question\s*$"#, r#"^\s*\? "#],
                any: [
                    (
                        contains: [r#"↵ choose"#],
                    ),
                    (
                        contains: [r#"↵ toggle"#],
                    ),
                    (
                        contains: [r#"↵ save"#],
                    ),
                ],
            ),
        ),
(
            id: r#"legacy_approval_panel"#,
            state: Some(Blocked),
            priority: 300,
            region: r#"whole_recent"#,
            gate: (
                contains: [r#"requesting approval"#, r#"reject"#],
                all: [
                    (
                        any: [
                            (
                                contains: [r#"1/2/3/4 choose"#],
                            ),
                            (
                                contains: [r#"↵ confirm"#],
                            ),
                        ],
                    ),
                ],
                any: [
                    (
                        contains: [r#"approve once"#],
                    ),
                    (
                        contains: [r#"approve for this session"#],
                    ),
                ],
            ),
        ),
(
            id: r#"background_agent_status_working"#,
            state: Some(Working),
            priority: 120,
            region: r#"bottom_non_empty_lines(3)"#,
            visible_working: true,
            gate: (
                line_regex: [r#"(?i)\bkimi[-\w.]*\s+thinking\b.*\[[1-9][0-9]*\s+agents?\s+running\]"#],
            ),
        ),
(
            id: r#"moon_spinner_working"#,
            state: Some(Working),
            priority: 100,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                line_regex: [r#"^\s*(🌕|🌖|🌗|🌘|🌑|🌒|🌓|🌔)\s*$"#],
            ),
        ),
(
            id: r#"braille_spinner_working"#,
            state: Some(Working),
            priority: 90,
            region: r#"whole_recent"#,
            visible_working: true,
            gate: (
                line_regex: [r#"(?i)^\s*[\u2800-\u28FF]+\s*(thinking\.\.\.|working\.\.\.|using )"#],
            ),
        ),
    ],
)
